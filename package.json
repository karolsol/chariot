{
  "name": "chariot",
  "version": "0.0.1-prelease",
  "description": "Vehicle tracking and management system",
  "author": "Karol Solecki",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/chariot/main",
    "build:all": "pnpm run build:libs && pnpm run build:backend && pnpm run build:frontend",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "build:backend": "nest build",
    "build:libs": "nest build shared",
    "build:frontend": "cd apps/frontend && npx vite build",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"nest start --watch\" \"cd apps/frontend && npx vite\"",
    "typeorm": "NODE_OPTIONS='-r tsconfig-paths/register' TS_NODE_PROJECT='apps/chariot/tsconfig.app.json' pnpm exec typeorm-ts-node-commonjs",
    "migration:generate": "pnpm typeorm migration:generate -d apps/chariot/src/config/data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d apps/chariot/src/config/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d apps/chariot/src/config/data-source.ts",
    "schema:log": "pnpm typeorm schema:log -d apps/chariot/src/config/data-source.ts"
  },
  "dependencies": {
    "@casl/ability": "6.8.0",
    "@nestjs/common": "11.1.13",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.13",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.13",
    "@nestjs/serve-static": "5.0.4",
    "@nestjs/typeorm": "11.0.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.13",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.2.0",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.3.0",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
