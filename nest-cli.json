{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/chariot/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/chariot/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/chariot",
  "projects": {
    "chariot": {
      "type": "application",
      "root": "apps/chariot",
      "entryFile": "main",
      "sourceRoot": "apps/chariot/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chariot/tsconfig.app.json"
      }
    },
    "frontend": {
      "type": "application",
      "root": "apps/frontend",
      "entryFile": "main",
      "sourceRoot": "apps/frontend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/frontend/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}