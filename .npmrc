save-exact=true
minimum-release-age=1440
#strictDepBuilds=true # block post* pre* scripts as they are frequent vectors for supply chain attacks (redundant as there is ignore-scripts)
blockExoticSubdeps=true # do not allow weird sources of subdeps like github or urls
engineStrict=true # do not run when package.json engine rule is not met
packageManagerStrictVersion=true # dont allow to use different version of package manager then stated in package.json
verifyDepsBeforeRun=error # fail if content of node_modules dont match lockfile
strict-ssl=true
registry=https://registry.npmjs.org/
frozen-lockfile=true
strict-ssl=true
shared-workspace-lockfile=true
link-workspace-packages=true
strict-peer-dependencies=true
ignore-scripts=true
audit=true
