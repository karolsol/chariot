{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "build": "nest build",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typeorm": "NODE_OPTIONS='-r tsconfig-paths/register' pnpm exec typeorm-ts-node-commonjs",
    "migration:generate": "sh -c 'pnpm typeorm migration:generate src/migrations/$1 -d src/config/data-source.ts' --",
    "migration:run": "pnpm typeorm migration:run -d src/config/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/config/data-source.ts",
    "schema:log": "pnpm typeorm schema:log -d src/config/data-source.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@casl/ability": "7.0.1",
    "@chariot/shared": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/typeorm": "12.0.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.0",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.7",
    "@swc/core": "1.16.2",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@vitest/coverage-v8": "5.0.1",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}