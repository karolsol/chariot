{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "build": "nest build",
    "typeorm": "NODE_OPTIONS='-r tsconfig-paths/register' TS_NODE_PROJECT='tsconfig.app.json' pnpm exec typeorm-ts-node-commonjs",
    "migration:generate": "sh -c 'pnpm typeorm migration:generate src/migrations/$1 -d src/config/data-source.ts' --",
    "migration:run": "pnpm typeorm migration:run -d src/config/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/config/data-source.ts",
    "schema:log": "pnpm typeorm schema:log -d src/config/data-source.ts"
  },
  "dependencies": {
    "@chariot/shared": "workspace:*",
    "@casl/ability": "6.8.1",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/typeorm": "11.0.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.29",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.19",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "25.6.0",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "7.2.0"
  }
}